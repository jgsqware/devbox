# devbox — ~/.bashrc
#
# Dérivé de `default/bashrc` d'Omarchy, adapté au moteur VENDORÉ : sur un vrai
# poste Omarchy, c'est le paquet `omarchy` qui pose /usr/share/omarchy et
# /etc/skel/.bashrc. Ici on ne l'installe pas (121 Mo de deps graphiques), donc
# on rétablit la même chaîne en pointant sur ~/.local/share/omarchy.
#
# ⛔ NE RIEN ÉDITER ICI : ce fichier est redéployé depuis le dépôt devbox.
#    Les ajouts vont dans ~/.config/devbox/rc.d/ (overlay/bash/rc.d/).

export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"

case ":$PATH:" in
  *":$OMARCHY_PATH/bin:"*) ;;
  *) export PATH="$OMARCHY_PATH/bin:$PATH" ;;
esac

# macOS : `ssh hôte cmd` (sonde mosh-server de `s`, Rex over SSH…) lance un
# bash NON login, qui ne lit pas ~/.bash_profile → ni Homebrew (mosh-server)
# ni ~/.local/bin (rex). On les ajoute ici, avant le return non interactif.
if [[ "$OSTYPE" == darwin* ]]; then
  for _p in /opt/homebrew/sbin /opt/homebrew/bin "$HOME/.local/bin"; do
    case ":$PATH:" in *":$_p:"*) ;; *) [[ -d "$_p" ]] && PATH="$_p:$PATH" ;; esac
  done
  unset _p
  export PATH
fi

# Session Rex (dev, devmac) : sort du groupe commun de rex.service vers son
# propre scope plafonné en mémoire (étape memcaps, plan #fvr63b). Avant le
# return : `bash -lc cmd` (sessions ov) n'est pas interactif. Sans le script
# (autres machines), rien ne se passe.
if [[ -x /usr/local/bin/devbox-rex-scope ]]; then
  read -r _cg < "/proc/$$/cgroup" 2>/dev/null
  [[ "${_cg:-}" == */rex.service ]] && /usr/local/bin/devbox-rex-scope "$$"
  unset _cg
fi

# Non interactif : on s'arrête ici (OMARCHY_PATH et PATH sont posés).
[[ $- != *i* ]] && return

# macOS : /bin/bash est un bash 3.2 que la chaîne Omarchy ne sait pas lire
# ([[ -v ]], declare -g, complete -I). On bascule sur le bash 5 de Homebrew.
if (( BASH_VERSINFO[0] < 4 )) && [[ -x /opt/homebrew/bin/bash ]]; then
  if shopt -q login_shell; then exec -l /opt/homebrew/bin/bash; else exec /opt/homebrew/bin/bash; fi
fi

# La chaîne Omarchy : envs · shell · aliases · functions · init
# (init = mise, starship, zoxide, fzf) · inputrc
[[ -r "$OMARCHY_PATH/default/bash/rc" ]] && source "$OMARCHY_PATH/default/bash/rc"

# Overrides devbox — chargés EN DERNIER, dans l'ordre des noms.
for _devbox_rc in "$HOME"/.config/devbox/rc.d/*.sh; do
  [[ -r "$_devbox_rc" ]] && source "$_devbox_rc"
done
unset _devbox_rc
