+#[cfg(test)]
+mod pane_title_tests {
+    use super::clean_pane_title;
+
+    const HOSTS: &[&str] = &["omarchy.lan", "omarchy"];
+
+    #[test]
+    fn strips_status_glyph() {
+        assert_eq!(clean_pane_title("✳ Tmux session aliases", HOSTS), "Tmux session aliases");
+        assert_eq!(clean_pane_title("⠂ Fix the build", HOSTS), "Fix the build");
+    }
+
+    #[test]
+    fn keeps_title_without_glyph() {
+        assert_eq!(clean_pane_title("Tmux session aliases pour zshrc", HOSTS), "Tmux session aliases pour zshrc");
+    }
+
+    #[test]
+    fn drops_default_titles() {
+        assert_eq!(clean_pane_title("omarchy", HOSTS), "");
+        assert_eq!(clean_pane_title("omarchy.lan", HOSTS), "");
+        assert_eq!(clean_pane_title("✳ Claude Code", HOSTS), "");
+        assert_eq!(clean_pane_title("", HOSTS), "");
+    }
+}
