+/// Claude Code titles its terminal with the conversation title, prefixed
+/// by `✳` when idle or a braille spinner while working (not always). Strip
+/// that glyph, and drop titles that are only tmux's default (the hostname)
+/// or Claude's generic one, so they never end up as the label.
+fn clean_pane_title(raw: &str, hosts: &[&str]) -> String {
+    let mut chars = raw.chars();
+    let title = match (chars.next(), chars.next()) {
+        (Some(glyph), Some(' ')) if !glyph.is_ascii() && !glyph.is_alphanumeric() => chars.as_str(),
+        _ => raw,
+    }
+    .trim();
+    if title.is_empty() || title == "Claude Code" || hosts.iter().any(|h| !h.is_empty() && *h == title) {
+        return String::new();
+    }
+    title.to_string()
+}
+
 fn q(field: &str) -> String {
     format!("#{{q:{field}}}")
 }
