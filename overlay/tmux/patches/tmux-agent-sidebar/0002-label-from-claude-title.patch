+/// Claude Code titles its terminal `<glyph> <conversation title>`, the
+/// glyph being `✳` when idle or a braille spinner while working. Keep the
+/// title only when it has that shape, so a default title (hostname, shell)
+/// never ends up as the label.
+fn clean_pane_title(raw: &str) -> String {
+    let mut chars = raw.chars();
+    match (chars.next(), chars.next()) {
+        (Some(glyph), Some(' ')) if !glyph.is_ascii() && !glyph.is_alphanumeric() => {
+            chars.as_str().trim().to_string()
+        }
+        _ => String::new(),
+    }
+}
+
 fn q(field: &str) -> String {
     format!("#{{q:{field}}}")
 }
