diff --git i/src/lib.rs w/src/lib.rs
index a161df1..f25c331 100644
--- i/src/lib.rs
+++ w/src/lib.rs
@@ -21,3 +21,19 @@ pub mod worktree;
 pub const SPINNER_ICON: &str = "●";
 pub const SPINNER_PULSE: &[u8] = &[82, 78, 114, 150, 186, 150, 114, 78];
 pub const VERSION: &str = env!("CARGO_PKG_VERSION");
+
+/// Popup mode: the list runs in a `display-popup` (env `AGENT_SIDEBAR_POPUP=1`)
+/// instead of a permanent sidebar pane. Enter jumps then quits, Esc quits.
+pub fn popup_mode() -> bool {
+    std::env::var("AGENT_SIDEBAR_POPUP").is_ok_and(|v| v == "1")
+}
+
+/// Set by the input handler in popup mode; the main loop exits on it.
+pub static POPUP_QUIT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Ask the popup to close (no-op outside popup mode).
+pub fn request_popup_quit() {
+    if popup_mode() {
+        POPUP_QUIT.store(true, std::sync::atomic::Ordering::Relaxed);
+    }
+}
