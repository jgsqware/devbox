#!/usr/bin/env python3
"""omarchy-ghostty-theme — applique un thème Omarchy à Ghostty sur le poste
hôte (macOS), comme `omarchy-theme-set` le fait sur un vrai Omarchy.

  omarchy-ghostty-theme                  choix interactif (fzf + aperçu en couleurs)
  omarchy-ghostty-theme set <nom>        applique un thème (nom ou slug, insensible à la casse)
  omarchy-ghostty-theme preview <nom>    aperçu du thème dans le terminal, sans l'appliquer
  omarchy-ghostty-theme next | prev      thème favori suivant / précédent
  omarchy-ghostty-theme fav [add|rm <nom>]  liste / ajoute / retire un favori
                                         (dans le sélecteur : ESPACE bascule le favori,
                                          ctrl-f n'affiche que les favoris, ctrl-a tout)
  omarchy-ghostty-theme list             liste les thèmes du catalogue
  omarchy-ghostty-theme current          thème actuellement appliqué
  omarchy-ghostty-theme refresh          re-télécharge le catalogue

Catalogue : https://github.com/limehawk/omarchy-theme-website (thèmes
intégrés + communauté). Pour chaque thème, on récupère son colors.toml —
ou, pour les thèmes plus anciens, son alacritty.toml converti comme le fait
omarchy-theme-colors-from-alacritty — puis on le rend avec le MÊME template
que Omarchy (default/themed/ghostty.conf.tpl).

Seules des couleurs #rrggbb validées atteignent la config Ghostty : un thème
tiers ne peut pas y glisser d'autres clés (command =, etc.) — même raison
qu'omarchy-theme-set refuse le ghostty.conf d'un thème installé.

Branchement dans Ghostty, comme sur Omarchy : une ligne
  config-file = ?"<état>/ghostty.conf"
ajoutée une fois à la config Ghostty, puis rechargement via SIGUSR2.
Pur stdlib python3 + curl (fournis avec les Command Line Tools de macOS).
"""

import json
import os
import re
import shutil
import signal
import subprocess
import shlex
import sys
import threading
import time
from pathlib import Path

CATALOG_URL = ("https://raw.githubusercontent.com/limehawk/omarchy-theme-website/"
               "main/src/data/themes-data.json")
CATALOG_TTL = 24 * 3600

HOME = Path.home()
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "omarchy-ghostty"
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "omarchy-ghostty"
THEME_CONF = STATE_DIR / "ghostty.conf"
CURRENT_FILE = STATE_DIR / "current"
FAV_FILE = STATE_DIR / "favorites"                    # un slug par ligne, dans l'ordre d'ajout
CATALOG_FILE = CACHE_DIR / "themes-data.json"
COLORS_CACHE = CACHE_DIR / "colors"                   # couleurs brutes par thème (slug.json)

HEX = re.compile(r"^#[0-9a-fA-F]{6}$")

# Omarchy default/themed/ghostty.conf.tpl, à l'identique
GHOSTTY_TPL = """\
background = {{ background }}
foreground = {{ foreground }}
cursor-color = {{ bright_foreground }}
selection-background = {{ selection_background }}
selection-foreground = {{ selection_foreground }}

palette = 0={{ background }}
palette = 1={{ red }}
palette = 2={{ green }}
palette = 3={{ yellow }}
palette = 4={{ blue }}
palette = 5={{ magenta }}
palette = 6={{ cyan }}
palette = 7={{ foreground }}
palette = 8={{ muted }}
palette = 9={{ bright_red }}
palette = 10={{ bright_green }}
palette = 11={{ bright_yellow }}
palette = 12={{ bright_blue }}
palette = 13={{ bright_magenta }}
palette = 14={{ bright_cyan }}
palette = 15={{ bright_foreground }}
"""


def die(msg):
    print(f"omarchy-ghostty-theme: {msg}", file=sys.stderr)
    sys.exit(1)


def fetch(url):
    """Contenu texte de l'URL, ou None si 404/erreur. curl plutôt qu'urllib :
    il utilise le trousseau système de macOS, pas besoin de certifi."""
    r = subprocess.run(["curl", "-fsSL", "--max-time", "20", url],
                       capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


# ------------------------------------------------------------- catalogue ---
def load_catalog(force=False):
    fresh = CATALOG_FILE.exists() and time.time() - CATALOG_FILE.stat().st_mtime < CATALOG_TTL
    if force or not fresh:
        data = fetch(CATALOG_URL)
        if data:
            CACHE_DIR.mkdir(parents=True, exist_ok=True)
            CATALOG_FILE.write_text(data)
        elif not CATALOG_FILE.exists():
            die(f"catalogue injoignable : {CATALOG_URL}")
    themes = json.loads(CATALOG_FILE.read_text())
    return sorted((t for t in themes if t.get("colors_source") in ("colors.toml", "alacritty.toml")),
                  key=lambda t: t["name"].lower())


def find_theme(themes, query):
    q = query.strip().lower()
    for key in ("slug", "name"):
        exact = [t for t in themes if t[key].lower() == q]
        if exact:
            return exact[0]
    partial = [t for t in themes if q in t["slug"].lower() or q in t["name"].lower()]
    if len(partial) == 1:
        return partial[0]
    if not partial:
        die(f"aucun thème ne correspond à « {query} » — voir : omarchy-ghostty-theme list")
    names = "\n  ".join(f"{t['name']}  ({t['slug']})" for t in partial[:20])
    die(f"« {query} » est ambigu :\n  {names}")


def raw_base(theme):
    """URL raw.githubusercontent.com du dossier du thème (dépôt entier, ou
    sous-dossier pour les thèmes intégrés : .../omarchy/tree/<branche>/themes/x)."""
    branch = theme["default_branch"]
    owner, repo = theme["github_owner"], theme["github_repo"]
    canon = theme.get("canonical_github_url") or ""
    m = re.match(r"https://github\.com/([^/]+)/([^/]+?)/?$", canon)
    if m:
        owner, repo = m.group(1), m.group(2)
    path = ""
    marker = f"/tree/{branch}/"
    if marker in theme["github_url"]:
        path = theme["github_url"].split(marker, 1)[1].strip("/") + "/"
    return f"https://raw.githubusercontent.com/{owner}/{repo}/{branch}/{path}"


# ------------------------------------------------------ couleurs Omarchy ---
def parse_colors_toml(text):
    """Même lecture qu'omarchy-theme-color : clé = valeur, guillemets ôtés."""
    colors = {}
    for line in text.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = re.sub(r"[\"' ]", "", key)
        if not key or key.startswith("#") or key.startswith("["):
            continue
        m = re.search(r"[\"']([^\"']*)[\"']", value)
        value = m.group(1) if m else value.split("#", 1)[0].strip()
        colors[key] = value.strip()
    return colors


def colors_from_alacritty(text):
    """Portage d'omarchy-theme-colors-from-alacritty : palette normal/bright,
    primary, selection → colors.toml « legacy » (color0..15)."""
    found, section = {}, ""
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("["):
            m = re.match(r"^\[([^\]]*)\]\s*$", s)
            section = m.group(1).strip() if m else ""
            continue
        if not section or "=" not in s or s.startswith("#"):
            continue
        key, value = (p.strip() for p in s.split("=", 1))
        m = re.match(r"^[\"']?(?:0[xX]|#)?([0-9a-fA-F]{6})[\"']?(\s*#.*)?$", value)
        if not m:
            continue
        found.setdefault(f"{section}.{key}", "#" + m.group(1).lower())

    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    normal = [found.get(f"colors.normal.{n}") for n in names]
    if not all(normal):
        return None
    bright = [found.get(f"colors.bright.{n}") or normal[i] for i, n in enumerate(names)]
    bg = found.get("colors.primary.background") or normal[0]
    fg = found.get("colors.primary.foreground") or normal[7]
    out = {f"color{i}": c for i, c in enumerate(normal + bright)}
    out.update(color0=bg, color7=fg, background=bg, foreground=fg,
               selection=found.get("colors.selection.background") or fg, accent=normal[4])
    return out


def mix(start, end, amount):
    a = [int(start[i:i + 2], 16) for i in (1, 3, 5)]
    b = [int(end[i:i + 2], 16) for i in (1, 3, 5)]
    return "#" + "".join(f"{int(x * (1 - amount) + y * amount + 0.5):02x}" for x, y in zip(a, b))


def resolve(c):
    """Sous-ensemble de resolve_theme_colors (omarchy-theme-color) : tout ce
    que le template ghostty consomme, avec les mêmes alias et replis."""
    def alias(key, fallback):
        if not c.get(key):
            c[key] = c.get(fallback, "")

    for key, short in (("background", "bg"), ("foreground", "fg"), ("dark_foreground", "dark_fg"),
                       ("bright_foreground", "bright_fg")):
        alias(key, short)
    alias("background", "color0")
    alias("foreground", "color7")
    for i, name in enumerate(["red", "green", "yellow", "blue", "magenta", "cyan"], start=1):
        alias(name, f"color{i}")
        alias(f"bright_{name}", f"color{i + 8}")
    alias("magenta", "purple")
    alias("bright_magenta", "bright_purple")
    c["bright_foreground"] = c.get("bright_foreground") or c.get("color15") or c["foreground"]
    c["dark_foreground"] = c.get("dark_foreground") or c.get("color8") or c["foreground"]
    c["muted"] = c.get("muted") or c.get("color8") or c["dark_foreground"]
    c["selection"] = (c.get("selection") or c.get("selection_background") or c.get("color8")
                      or c.get("color0") or c["background"])
    alias("selection_background", "selection")
    alias("selection_foreground", "bright_foreground")
    for name in ["red", "yellow", "green", "cyan", "blue", "magenta"]:
        if not c.get(f"bright_{name}") and HEX.match(c.get(name, "")):
            c[f"bright_{name}"] = mix(c[name], "#ffffff", 0.20)
    return c


def render(colors):
    def sub(m):
        value = colors.get(m.group(1), "")
        if not HEX.match(value):
            raise ValueError(m.group(1))
        return value.lower()
    try:
        return re.sub(r"\{\{ (\w+) \}\}", sub, GHOSTTY_TPL)
    except ValueError as e:
        die(f"couleur « {e} » absente ou invalide dans ce thème (attendu #rrggbb)")


# --------------------------------------------------------------- ghostty ---
def ghostty_config_path():
    """Config existante (XDG d'abord, puis l'emplacement macOS), sinon XDG."""
    xdg = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "ghostty" / "config"
    mac = HOME / "Library/Application Support/com.mitchellh.ghostty/config"
    for p in (xdg, mac):
        if p.exists():
            return p
    return xdg


def ensure_include():
    cfg = ghostty_config_path()
    line = f'config-file = ?"{THEME_CONF}"'
    text = cfg.read_text() if cfg.exists() else ""
    if str(THEME_CONF) in text:
        return cfg, None
    cfg.parent.mkdir(parents=True, exist_ok=True)
    backup = None
    if text:
        backup = cfg.with_name(cfg.name + ".omarchy-bak")
        shutil.copy2(cfg, backup)
    sep = "" if not text or text.endswith("\n") else "\n"
    cfg.write_text(f"{text}{sep}\n# Thème Omarchy (omarchy-ghostty-theme)\n{line}\n")
    return cfg, backup or "créée"


def reload_ghostty():
    """SIGUSR2 = rechargement de config dans Ghostty (1.2+)."""
    r = subprocess.run(["pgrep", "-x", "ghostty"], capture_output=True, text=True)
    pids = [int(p) for p in r.stdout.split()]
    for pid in pids:
        try:
            os.kill(pid, signal.SIGUSR2)
        except OSError:
            pass
    return bool(pids)


# ------------------------------------------------------------- commandes ---
def theme_colors(theme, use_cache=True):
    """Couleurs RÉSOLUES du thème, ou None. Les couleurs brutes sont mises en
    cache (même TTL que le catalogue) : l'aperçu fzf rappelle ceci à chaque
    déplacement, et `set` juste après n'a plus rien à télécharger."""
    cache = COLORS_CACHE / f"{theme['slug']}.json"
    if use_cache and cache.exists() and time.time() - cache.stat().st_mtime < CATALOG_TTL:
        raw = json.loads(cache.read_text())
    else:
        base = raw_base(theme)
        raw = None
        text = fetch(base + "colors.toml")
        if text:
            raw = parse_colors_toml(text)
        else:
            text = fetch(base + "alacritty.toml")
            if text:
                raw = colors_from_alacritty(text)
        if not raw:
            return None
        COLORS_CACHE.mkdir(parents=True, exist_ok=True)
        tmp = cache.with_suffix(f".{os.getpid()}.tmp")   # écriture atomique : aperçu et préchargement en parallèle
        tmp.write_text(json.dumps(raw))
        tmp.replace(cache)
    return resolve(dict(raw))


def prefetch(themes, workers=12):
    """Remplit le cache des couleurs en arrière-plan pendant que fzf tourne :
    les aperçus deviennent instantanés au fil de la navigation."""
    todo = [t for t in themes if not (COLORS_CACHE / f"{t['slug']}.json").exists()]
    lock = threading.Lock()

    def worker():
        while True:
            with lock:
                if not todo:
                    return
                t = todo.pop()
            try:
                theme_colors(t)
            except Exception:
                pass

    for _ in range(workers):
        threading.Thread(target=worker, daemon=True).start()


# ---------------------------------------------------------------- aperçu ---
# Même idée que `ghostty +list-themes` : le thème rendu dans le terminal, en
# vraies couleurs 24 bits — fond, texte, palette 16 couleurs, sélection,
# curseur et un extrait shell/code coloré avec la palette ANSI du thème.
PALETTE = ["background", "red", "green", "yellow", "blue", "magenta", "cyan", "foreground",
           "muted", "bright_red", "bright_green", "bright_yellow", "bright_blue",
           "bright_magenta", "bright_cyan", "bright_foreground"]


def _rgb(h):
    return ";".join(str(int(h[i:i + 2], 16)) for i in (1, 3, 5))


def preview_text(theme, c, width):
    bg, fg = c["background"], c["foreground"]
    reset = "\x1b[0m"

    def seg(text, color=None, bold=False, back=None):
        return (f"\x1b[48;2;{_rgb(back or bg)}m\x1b[38;2;{_rgb(color or fg)}m"
                + ("\x1b[1m" if bold else "") + text + "\x1b[22m")

    def line(*segs):
        visible = sum(len(re.sub(r"\x1b\[[0-9;]*m", "", x)) for x in segs)
        return "".join(segs) + seg(" " * max(0, width - visible)) + reset

    def swatches(start):
        # 8 cases qui tiennent dans la largeur de l'aperçu ; la 0 EST le fond :
        # numéro en `muted` et case soulignée pour qu'elle reste repérable.
        block = max(2, (width - 1) // 8 - 3)
        cells = []
        for i in range(start, start + 8):
            color = c[PALETTE[i]]
            label = c["muted"] if color == bg else color
            fill = ("▁" * block) if color == bg else " " * block
            cells.append(seg(f" {i:>2}", label) + seg(fill, label, back=color))
        return line(seg(" "), *cells)

    mode = "clair" if c.get("mode") == "light" or sum(int(bg[i:i + 2], 16) for i in (1, 3, 5)) > 382 else "sombre"
    rows = [
        line(),
        line(seg(f" {theme['name']}", c["blue"], bold=True), seg(f"  · {mode} · {theme['colors_source']}", c["muted"])),
        line(),
        swatches(0),
        swatches(8),
        line(),
        line(seg(" ❯ ", c["green"], bold=True), seg("ls -la "), seg("~/projets", c["cyan"])),
        line(seg(" drwxr-xr-x ", c["muted"]), seg("src/", c["bright_blue"], bold=True),
             seg("   -rw-r--r-- ", c["muted"]), seg("README.md")),
        line(seg(" ❯ ", c["green"], bold=True), seg("git status")),
        line(seg(" modified:   ", c["red"]), seg("app.py", c["red"]), seg("   new file: ", c["green"]),
             seg("theme.py", c["green"])),
        line(),
        line(seg(" def ", c["magenta"]), seg("greet", c["blue"]), seg("(name: "), seg("str", c["yellow"]), seg(") -> "),
             seg("str", c["yellow"]), seg(":")),
        line(seg("     "), seg("# salue quelqu'un", c["muted"])),
        line(seg("     "), seg("return ", c["magenta"]), seg('f"Bonjour, ', c["green"]), seg("{name}", c["cyan"]),
             seg('!"', c["green"])),
        line(seg(" count "), seg("= "), seg("42", c["bright_yellow"]),
             seg("   ok ", c["bright_green"]), seg("warn ", c["bright_yellow"]), seg("err", c["bright_red"])),
        line(),
        line(seg(" "), seg(" texte sélectionné ", c["selection_foreground"], back=c["selection_background"]),
             seg("  curseur "), seg(" ", back=c["bright_foreground"])),
        line(),
    ]
    return "\n".join(rows)


def cmd_preview(themes, query):
    theme = find_theme(themes, query)
    colors = theme_colors(theme)
    if not colors:
        print(f"{theme['name']} : couleurs introuvables")
        return
    width = int(os.environ.get("FZF_PREVIEW_COLUMNS") or shutil.get_terminal_size((80, 24)).columns)
    print(preview_text(theme, colors, width))


def cmd_set(themes, query, reload=True):
    theme = find_theme(themes, query)
    colors = theme_colors(theme)
    if not colors:
        die(f"{theme['name']} : ni colors.toml ni alacritty.toml exploitable sous {raw_base(theme)}")

    conf = render(colors)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    THEME_CONF.write_text(f"# {theme['name']} — {theme['github_url']}\n{conf}")
    CURRENT_FILE.write_text(f"{theme['slug']}\t{theme['name']}\n")

    cfg, change = ensure_include()
    print(f"✅ {theme['name']} → {THEME_CONF}")
    if change == "créée":
        print(f"   config Ghostty créée : {cfg}")
    elif change:
        print(f"   include ajouté à {cfg} (sauvegarde : {change})")
    if reload:
        if reload_ghostty():
            print("   Ghostty rechargé")
        else:
            print("   Ghostty ne tourne pas — appliqué au prochain lancement")


# ------------------------------------------------------------- favoris ---
def load_favs():
    return [l.strip() for l in FAV_FILE.read_text().splitlines() if l.strip()] if FAV_FILE.exists() else []


def save_favs(favs):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FAV_FILE.write_text("".join(f"{f}\n" for f in favs))


def toggle_fav(slug):
    favs = load_favs()
    if slug in favs:
        favs.remove(slug)
    else:
        favs.append(slug)
    save_favs(favs)
    return slug in favs


def picker_lines(themes, only_favs=False):
    """Ordre alphabétique STABLE (les favoris ne remontent pas) : après un
    ESPACE, fzf recharge la liste et le curseur reste sur la même ligne."""
    favs = set(load_favs())
    return "\n".join(f"{'★' if t['slug'] in favs else ' '} {t['name']}\t{t['slug']}"
                     for t in themes if not only_favs or t["slug"] in favs)


def cmd_fav(themes, args):
    if not args:
        by_slug = {t["slug"]: t for t in themes}
        favs = load_favs()
        if not favs:
            print("aucun favori — ESPACE dans le sélecteur, ou : omarchy-ghostty-theme fav add <nom>")
        for f in favs:
            print(f"★ {f:30} {by_slug[f]['name'] if f in by_slug else '(absent du catalogue)'}")
        return
    action, query = args[0], " ".join(args[1:])
    if action == "toggle":                      # appelé par fzf avec le slug exact
        toggle_fav(query)
        return
    if action not in ("add", "rm") or not query:
        die("usage : omarchy-ghostty-theme fav [add|rm <nom>]")
    theme = find_theme(themes, query)
    favs = load_favs()
    if action == "add" and theme["slug"] not in favs:
        favs.append(theme["slug"])
    elif action == "rm" and theme["slug"] in favs:
        favs.remove(theme["slug"])
    save_favs(favs)
    print(f"{'★ ajouté' if action == 'add' else 'retiré'} : {theme['name']}")


def cmd_cycle(themes, step, reload=True):
    favs = [f for f in load_favs() if any(t["slug"] == f for t in themes)]
    if not favs:
        die("aucun favori — ESPACE dans le sélecteur, ou : omarchy-ghostty-theme fav add <nom>")
    current = CURRENT_FILE.read_text().split("\t")[0] if CURRENT_FILE.exists() else None
    i = favs.index(current) + step if current in favs else (0 if step > 0 else -1)
    cmd_set(themes, favs[i % len(favs)], reload)


def cmd_pick(themes, reload=True):
    if not shutil.which("fzf"):
        for t in themes:
            print(f"{t['slug']:32} {t['name']}")
        print("\nfzf absent (brew install fzf) — puis : omarchy-ghostty-theme set <slug>")
        return
    prefetch(themes)
    me = shlex.quote(os.path.realpath(sys.argv[0]))
    r = subprocess.run(["fzf", "--delimiter=\t", "--with-nth=1", "--prompt=thème> ",
                        "--height=90%", "--reverse", "--ansi",
                        "--header=espace ★ favori · ctrl-f favoris · ctrl-a tout · entrée appliquer",
                        f"--bind=space:execute-silent({me} fav toggle {{2}})+reload-sync({me} _lines)",
                        f"--bind=ctrl-f:reload-sync({me} _lines --favs)+first",
                        f"--bind=ctrl-a:reload-sync({me} _lines)+first",
                        f"--preview={me} preview {{2}}", "--preview-window=right,65%,border-left"],
                       input=picker_lines(themes), stdout=subprocess.PIPE, text=True)
    if r.returncode == 0 and r.stdout.strip():
        cmd_set(themes, r.stdout.strip().split("\t")[1], reload)


def main(argv):
    args = [a for a in argv if a != "--no-reload"]
    reload = "--no-reload" not in argv
    cmd = args[0] if args else "pick"
    if cmd in ("-h", "--help", "help"):
        print(__doc__.split("\n\n")[0] + "\n" + __doc__.split("\n\n")[1])
    elif cmd == "current":
        print(CURRENT_FILE.read_text().split("\t")[1].strip() if CURRENT_FILE.exists() else "aucun")
    elif cmd == "refresh":
        shutil.rmtree(COLORS_CACHE, ignore_errors=True)
        print(f"{len(load_catalog(force=True))} thèmes au catalogue")
    elif cmd == "preview":
        if len(args) < 2:
            die("usage : omarchy-ghostty-theme preview <nom>")
        cmd_preview(load_catalog(), " ".join(args[1:]))
    elif cmd == "list":
        for t in load_catalog():
            print(f"{t['slug']:32} {t['name']}")
    elif cmd == "set":
        if len(args) < 2:
            die("usage : omarchy-ghostty-theme set <nom>")
        cmd_set(load_catalog(), " ".join(args[1:]), reload)
    elif cmd == "fav":
        cmd_fav(load_catalog(), args[1:])
    elif cmd in ("next", "prev"):
        cmd_cycle(load_catalog(), 1 if cmd == "next" else -1, reload)
    elif cmd == "_lines":                       # interne : liste rechargée par fzf
        print(picker_lines(load_catalog(), only_favs="--favs" in args))
    elif cmd == "pick":
        cmd_pick(load_catalog(), reload)
    else:
        cmd_set(load_catalog(), " ".join(args), reload)   # raccourci : omarchy-ghostty-theme <nom>


if __name__ == "__main__":
    main(sys.argv[1:])
